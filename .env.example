# Optional: set USE_LOCAL_MONGO=true and create .env.local with mongodb://localhost:27017
# Local venv: py -3.12 -m venv venv  (Python 3.13/3.14 breaks Atlas TLS on Windows)
MONGODB_URI=mongodb+srv://USER:PASSWORD@ieee-converter-cluster.abqlzvb.mongodb.net/?retryWrites=true&w=majority&appName=ieee-converter-cluster
MONGODB_DB=ieee_converter
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# LLM semantic mapping (Claude recommended)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_REQUEST_TIMEOUT=300
LLM_MAX_RETRIES=1

# Or OpenAI instead
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o
