LLM_PROVIDER=anthropic
LLM_MODEL_GENERATION=claude-sonnet-4-20250514
LLM_MODEL_MATCHING=claude-3-5-haiku-20241022
LLM_MODEL_EXTRACTION=claude-3-5-haiku-20241022
OPENAI_API_KEY=
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Gemini (set LLM_PROVIDER=gemini and GEMINI_API_KEY; GEMINI_MODEL used when role models are still Claude ids)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
MAX_RETRIES=3
DATA_DIR=./data
DB_URL=sqlite:///./jobs.db
# JSON list — include your Vercel app origin for production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://internal-tool-sepia.vercel.app"]
# Optional: preview URLs on *.vercel.app are allowed via CORS_ORIGIN_REGEX in config
SCHEMA_CACHE_TTL_DAYS=30
MAX_PDF_PAGES=100
LOG_LEVEL=INFO
# Set true on Render free (512MB) to avoid OOM during PDF table extraction
LIGHT_PDF_EXTRACT=true
LLM_FALLBACK_MOCK=true
