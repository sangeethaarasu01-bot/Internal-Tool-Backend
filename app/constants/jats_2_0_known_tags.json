    "publisher-name": {
      "allowed_children": [],
      "allowed_attributes": [],
      "text_content": true
    },
    "fig-count": {
      "allowed_children": [],
      "allowed_attributes": ["count"],
      "text_content": false
    },
    "table-count": {
      "allowed_children": [],
      "allowed_attributes": ["count"],
      "text_content": false
    },
    "equation-count": {
      "allowed_children": [],
      "allowed_attributes": ["count"],
      "text_content": false
    },
    "ref-count": {
      "allowed_children": [],
      "allowed_attributes": ["count"],
      "text_content": false
    },
    "page-count": {
      "allowed_children": [],
      "allowed_attributes": ["count"],
      "text_content": false
    },
    "element-citation": {
      "allowed_children": [
        "person-group",
        "article-title",
        "source",
        "volume",
        "issue",
        "fpage",
        "lpage",
        "year",
        "pub-id"
      ],
      "allowed_attributes": ["publication-type"],
      "text_content": false
