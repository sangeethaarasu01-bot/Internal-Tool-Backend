      "allowed_attributes": [
        "article-type",
        "content-type",
        "dtd-version",
        "lifecycle",
        "open-access",
        "peer-reviewed",
        "xml:lang"
      ],
      "cardinality": {
        "front": "1",
        "body": "1",
        "back": "1"
      }
    },
    "front": {
      "allowed_children": ["journal-meta", "article-meta"],
      "allowed_attributes": [],
