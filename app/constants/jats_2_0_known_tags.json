    "given-names": {"allowed_children": [], "allowed_attributes": [], "text_content": true},
    "surname": {"allowed_children": [], "allowed_attributes": [], "text_content": true},
    "email": {"allowed_children": [], "allowed_attributes": [], "text_content": true},
