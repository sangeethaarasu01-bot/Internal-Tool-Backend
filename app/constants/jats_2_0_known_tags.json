        "article-id": "1..*",
        "title-group": "1",
        "contrib-group": "1",
        "aff": "1..*",
        "pub-date": "0..1",
        "abstract": "0..1",
        "kwd-group": "0..1",
        "counts": "0..1"
      }
    },
