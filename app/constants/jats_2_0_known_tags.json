    "issn": ["publication-format"],
    "pub-date": ["date-type", "pub-type", "iso-8601-date"],
    "kwd-group": ["kwd-group-type"],
    "fig-count": ["count"],
    "table-count": ["count"],
    "ref-count": ["count"],
    "sec": ["id"],
    "fig": ["id"],
    "table-wrap": ["id"],
    "ref": ["id"],
    "bio": ["id"],
    "aff": ["id"],
    "string-name": ["specific-use"],
    "person-group": ["person-group-type"]
  },
  "root_attributes": {
    "article-type": {
      "required": false,
      "values": ["research", "review", "letter", "correction"]
    },
    "dtd-version": {"required": true, "values": ["2.0"]},
    "xml:lang": {"required": true, "default": "eng"}
  }
