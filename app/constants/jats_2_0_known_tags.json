      "allowed_children": [
        "label",
        "title",
        "p",
        "sec",
        "disp-formula",
        "inline-formula",
        "fig",
        "table-wrap",
        "list",
        "supplementary-material"
      ],
      "allowed_attributes": ["id"],
      "cardinality": {
        "label": "0..1",
        "title": "0..1",
        "p": "0..*",
        "sec": "0..*"
