    "bold": {"allowed_children": [], "allowed_attributes": [], "text_content": true},
    "italic": {"allowed_children": [], "allowed_attributes": [], "text_content": true},
    "sub": {"allowed_children": [], "allowed_attributes": [], "text_content": true},
